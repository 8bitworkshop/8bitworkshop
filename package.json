{
  "name": "8bitworkshop",
  "version": "4.0.0",
  "author": "Steven Hugg",
  "category": "Development",
  "description": "8bitworkshop.com retro programming IDE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8bitworkshop/8bitworkshop.git"
  },
  "license": "GPL-3.0",
  "bin": {
    "8bws": "./gen/tools/8bws.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/view": "^6.39.14",
    "@fazelstudio/codemirror-lang-c": "^0.1.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@lezer/lr": "^1.4.8",
    "@types/dompurify": "^3.0.5",
    "@types/emscripten": "^1.39.5",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "atob": "^2.1.x",
    "binaryen": "^101.0.0",
    "btoa": "^1.2.x",
    "clipboard": "^2.0.6",
    "codemirror": "^6.0.2",
    "dompurify": "^3.1.7",
    "file-saver": "^2.0.5",
    "jszip": "^3.7.0",
    "localforage": "^1.9.0",
    "minisearch": "^7.2.0",
    "mousetrap": "^1.6.5",
    "octokat": "^0.10.0",
    "pako": "^2.2.0",
    "split.js": "^1.6.2"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@types/bootbox": "^5.1.3",
    "@types/bootstrap": "^3.4.0",
    "@types/expect": "^24.3.0",
    "@types/file-saver": "^2.0.3",
    "@types/jquery": "^3.5.34",
    "@types/mocha": "^10.0.8",
    "@types/node": "^22.7.4",
    "bootstrap": "^3.4.1",
    "bootstrap-tourist": "^0.2.1",
    "command-exists": "^1.2.9",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "express": "^4.18.2",
    "fast-png": "^6.4.0",
    "jquery": "^3.7.1",
    "jsdom": "^25.0.1",
    "lzg": "^1.0.x",
    "markdown-it": "^15.0.2",
    "mocha": "^12.0.1",
    "mocha-suppress-logs": "^0.6.0",
    "supports-terminal-graphics": "^0.1.0",
    "typescript": "^5.9.2",
    "typescript-formatter": "^7.2.2"
  },
  "optionalDependencies": {
    "chromedriver": "^154.0.0",
    "heapdump": "^0.3.15",
    "jsfuzz": "^1.0.14",
    "nightwatch": "^3.12.2"
  },
  "peerDependencies": {
    "quickjs-wasi": "^2.2.0"
  },
  "overrides": {
    "fetch-vcr": {
      "node-fetch": "2.6.7"
    },
    "serialize-javascript": "6.0.2",
    "cross-spawn": "7.0.5"
  },
  "scripts": {
    "build": "make prepare",
    "test": "npm run tsbuild && npm run test-node",
    "tsbuild": "tsc --build tsconfig.json test/tsconfig.json",
    "tslint": "tsc --build -noEmit tsconfig.json test/tsconfig.json",
    "esbuild": "node scripts/build.mjs",
    "esbuild-clean": "rm -rf ./gen",
    "server": "npm run esbuild -- server && rm -fr ./server-root/sessions && node gen/server/server.js",
    "test-one": "NODE_PATH=$(pwd) mocha --recursive --timeout 60000",
    "test-node": "NODE_PATH=$(pwd) mocha --parallel --require mocha-suppress-logs --recursive --timeout 60000 test/cli gen/test",
    "test-profile": "NODE_PATH=$(pwd) mocha --recursive --timeout 60000 --prof test/cli gen/test",
    "test-worker": "NODE_PATH=$(pwd) mocha --timeout 60000 test/cli/testworker.js",
    "test-platforms": "NODE_PATH=$(pwd) mocha --timeout 60000 test/cli/testplatforms.js",
    "test-cli": "NODE_PATH=$(pwd) mocha --timeout 60000 test/cli/testcli.js",
    "test-services": "NODE_PATH=$(pwd) mocha --timeout 60000 test/services",
    "test-verilog": "NODE_PATH=$(pwd) mocha --timeout 60000 test/verilog/testverilog.js",
    "test-extension": "cd extension && npm run assets-quick && npm run test",
    "test-web-quick": "nightwatch -e chrome test/web/testembed.js",
    "test-web-all": "nightwatch -e chrome test/web",
    "fuzzbasic": "jsfuzz gen/common/basic/fuzz.js ~/basic/corpus/ --versifier false",
    "fuzzhdl": "jsfuzz -r binaryen gen/common/hdl/fuzz.js ~/verilator/corpus/ --versifier false",
    "cli": "node gen/tools/8bws.js",
    "buildpresets": "NODE_PATH=$(pwd) node gen/tools/buildpresets.js",
    "toolversions": "node gen/tools/toolversions.js",
    "doctools": "node gen/tools/doctools.js",
    "mkdoc": "typedoc --out web/jsdoc src/common/"
  },
  "keywords": [
    "8bit",
    "ide",
    "retrodev",
    "6502",
    "z80"
  ],
  "bugs": {
    "url": "https://github.com/8bitworkshop/8bitworkshop/issues"
  },
  "homepage": "https://github.com/8bitworkshop/8bitworkshop#readme",
  "build": {
    "appId": "com.8bitworkshop.ide",
    "icon": "meta/icons/8bitworkshop-icon-1024.png",
    "copyright": "Copyright (c) 2023 Puzzling Plans LLC",
    "linux": {
      "category": "Development"
    }
  },
  "imports": {
    "#javatari-core": "./javatari.js/release/core/javatari-core.js"
  }
}
